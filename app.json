{
  "expo": {
    "name": "KSP Electronics",
    "slug": "ksp-electronics",
    "version": "1.0.0",
    "scheme": "ksp",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "in.kspelectronics.app",
      "associatedDomains": [
        "applinks:kspelectronics.in"
      ],
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "in.kspelectronics.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "kspelectronics.in",
              "pathPrefix": "/product"
            },
            {
              "scheme": "https",
              "host": "kspelectronics.in",
              "pathPrefix": "/shop"
            },
            {
              "scheme": "https",
              "host": "kspelectronics.in",
              "pathPrefix": "/cart"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "versionCode": 1,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "WAKE_LOCK",
        "RECEIVE_BOOT_COMPLETED"
      ],
      "allowBackup": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-image",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "KSP Electronics uses your location once, to find your pincode for delivery."
        }
      ],
      "./plugins/withAndroidShortcuts.js"
    ],
    "description": "KSP Electronics: 3D printers, Raspberry Pi, Arduino, ESP32, sensors and electronics, delivered across India."
  }
}
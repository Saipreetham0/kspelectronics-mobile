# Base URL of the Next.js API. The app calls only this, never WooCommerce directly.
# Production: https://store.kspelectronics.in
# Local dev: http://localhost:3000 (iOS simulator) or http://10.0.2.2:3000 (Android emulator)
EXPO_PUBLIC_API_URL=https://store.kspelectronics.in
# Optional backup: when the main address can't be reached, read requests retry here.
EXPO_PUBLIC_API_URL_BACKUP=
